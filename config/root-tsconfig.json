{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "downlevelIteration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": "..",
    "paths": {
      "@kv/entities": ["packages/entities/src/index.ts"],
      "@kv/ingestion": ["packages/ingestion/src/index.ts"],
      "@kv/knowledge-graph": ["packages/knowledge-graph/src/index.ts"],
      "@kv/media": ["packages/media/src/index.ts"],
      "@kv/processors": ["packages/processors/src/index.ts"],
      "@kv/types": ["packages/types/src/index.ts"],
      "@kv/utils": ["packages/utils/src/index.ts"]
    }
  },
  "include": ["apps/kv_database/src/**/*", "apps/tools/**/*", "packages/*/src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
