{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "mutate": [
    "apps/kv_database/src/lib/utils.ts",
    "apps/kv_database/src/lib/database.ts",
    "apps/kv_database/src/lib/embeddings.ts",
    "apps/kv_database/src/lib/types/**/*.ts",
    "apps/tools/**/*.ts"
  ],
  "testRunnerOptions": {
    "vitest": {
      "run": true,
      "reporter": "verbose",
      "config": "config/vitest.config.ts"
    }
  },
  "thresholds": {
    "high": 80,
    "low": 30,
    "break": null
  },
  "concurrency": 2,
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "incremental": true,
  "tempDirName": "stryker-tmp",
  "disableTypeChecks": "**/*.ts",
  "checkers": [],
  "testRunnerNodeArgs": []
}
