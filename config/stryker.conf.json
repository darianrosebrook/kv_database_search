{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress", "json"],
  "coverageAnalysis": "off",
  "mutate": [
    "apps/kv_database/src/lib/**/*.ts",
    "apps/kv_database/src/server/**/*.ts",
    "!apps/kv_database/src/lib/**/*.test.ts",
    "!apps/kv_database/src/lib/**/*.spec.ts",
    "!apps/kv_database/src/**/*.d.ts",
    "!apps/kv_database/src/lib/__tests__/**/*.ts"
  ],
  "ignorePatterns": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.d.ts",
    "**/node_modules/**",
    "**/dist/**",
    "**/test/**",
    "**/tests/**",
    "**/coverage/**",
    "**/.caws/**",
    "**/apps/tools/caws/**"
  ],
  "testRunnerOptions": {
    "vitest": {
      "run": true,
      "reporter": "verbose",
      "config": "config/vitest.config.ts"
    }
  },
  "thresholds": {
    "high": 80,
    "low": 30,
    "break": null
  },
  "concurrency": 2,
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "incremental": true,
  "tempDirName": "stryker-tmp",
  "disableTypeChecks": "**/*.ts",
  "checkers": [],
  "testRunnerNodeArgs": []
}
