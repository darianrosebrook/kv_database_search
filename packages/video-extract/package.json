{
  "name": "@obsidian-rag/video-extract",
  "version": "0.1.0",
  "description": "Extract text, transcription, and keyframes from video files",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "video-extract": "./bin/video-extract.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3",
    "nodejs-whisper": "^0.2.9",
    "@obsidian-rag/media-processing": "workspace:*"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
